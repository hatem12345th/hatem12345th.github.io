	{ name === 'briefcase' && <><rect width="20" height="14" x="2" y="7" rx="2" /><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16M2 12h20" /></> }
	{ name === 'send' && <><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></> }
	{ name === 'external-link' && <><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></> }
	{ name === 'arrow-right' && <><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></> }
	{ name === 'chevron-down' && <path d="m6 9 6 6 6-6" /> }
</svg>
