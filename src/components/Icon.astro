---
<svg {...iconProps}>
	{ name === 'menu' && <><line x1="4" x2="20" y1="6" y2="6" /><line x1="4" x2="20" y1="12" y2="12" /><line x1="4" x2="20" y1="18" y2="18" /></> }
	{ name === 'x' && <><path d="M18 6 6 18" /><path d="m6 6 12 12" /></> }
	{ name === 'github' && <><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3 0 6.7-1.6 6.7-7A5.4 5.4 0 0 0 19.5 4 5 5 0 0 0 19.4.5S18.2.1 15 2.2a13.4 13.4 0 0 0-6 0C5.8.1 4.6.5 4.6.5a5 5 0 0 0-.1 3.5A5.4 5.4 0 0 0 3.3 7.5c0 5.4 3.4 7 6.7 7a4.8 4.8 0 0 0-1 3.5v4" /><path d="M9 18c-4.5 2-5-2-7-2" /></> }
	{ name === 'linkedin' && <><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6Z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></> }
